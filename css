/* =============================================
   styles.css – Karabo Nail Bar & Hair Salon
   ============================================= */

/* === RESET & BASE === */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    line-height: 1.7;
    color: #2c2c2c;
    background-color: #fdfaf7;
}

/* === TYPOGRAPHY === */
h1 {
    font-size: 2rem;
    font-weight: normal;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;
}

h2 {
    font-size: 1.6rem;
    font-weight: normal;
    color: #7b3f5e;
    margin-bottom: 1rem;
    letter-spacing: 1px;
}

h3 {
    font-size: 1.2rem;
    color: #5a2d4a;
    margin: 1.5rem 0 0.5rem;
}

h4 {
    font-size: 1rem;
    color: #5a2d4a;
    margin-bottom: 0.4rem;
}

p {
    margin-bottom: 1rem;
    color: #3d3d3d;
}

a {
    color: #7b3f5e;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
    color: #5a2d4a;
}

small {
    color: #888;
    font-size: 0.85rem;
}

/* === HEADER === */
header {
    background-color: #7b3f5e;
    padding: 1.2rem 2rem;
    text-align: center;
}

header h1 {
    margin-bottom: 0.8rem;
}

/* === NAV === */
nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 1rem;
    padding: 0;
}

nav ul li a {
    color: #f5e6ef;
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.2s;
}

nav ul li a:hover {
    background-color: #5a2d4a;
    text-decoration: none;
    color: #fff;
}

/* === MAIN === */
main {
    max-width: 960px;
    margin: 2.5rem auto;
    padding: 0 1.5rem;
}

/* === SECTIONS === */
section {
    margin-bottom: 3rem;
}

/* === ARTICLES === */
article {
    background: #fff;
    border: 1px solid #f0dde8;
    border-radius: 8px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 1.5rem;
}

article h3, article h4 {
    margin-top: 0;
}

/* === FIGURES & IMAGES === */
figure {
    display: inline-block;
    margin: 0.8rem;
    text-align: center;
    vertical-align: top;
}

figure img {
    display: block;
    border-radius: 6px;
    border: 2px solid #f0dde8;
    width: 200px;
    height: 160px;
    object-fit: cover;
}

figcaption {
    font-size: 0.88rem;
    color: #7b3f5e;
    margin-top: 0.4rem;
}

/* === GALLERY GRID === */
.gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-start;
}

/* === FORMS === */
form p {
    margin-bottom: 1.2rem;
}

label {
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
    color: #5a2d4a;
    font-weight: bold;
    display: block;
    margin-bottom: 4px;
}

input[type="text"],
input[type="email"],
input[type="tel"],
input[type="date"],
input[type="time"],
select,
textarea {
    width: 100%;
    max-width: 480px;
    padding: 0.6rem 0.8rem;
    border: 1px solid #d9b8cc;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: Arial, sans-serif;
    background-color: #fff;
    color: #2c2c2c;
    transition: border-color 0.2s;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #7b3f5e;
    box-shadow: 0 0 0 3px rgba(123, 63, 94, 0.12);
}

textarea {
    resize: vertical;
}

button[type="submit"] {
    background-color: #7b3f5e;
    color: #fff;
    border: none;
    padding: 0.7rem 2rem;
    font-size: 1rem;
    font-family: Arial, sans-serif;
    border-radius: 6px;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: background 0.2s;
}

button[type="submit"]:hover {
    background-color: #5a2d4a;
}

/* === CONTACT PAGE === */
iframe {
    border-radius: 8px;
    margin-top: 1rem;
    max-width: 100%;
}

/* === HR === */
hr {
    border: none;
    border-top: 1px solid #f0dde8;
    margin: 2rem 0;
}

/* === FOOTER === */
footer {
    background-color: #7b3f5e;
    color: #f5e6ef;
    text-align: center;
    padding: 1.2rem 2rem;
    font-family: Arial, sans-serif;
    font-size: 0.88rem;
    margin-top: 3rem;
}

/* === RESPONSIVE === */
@media (max-width: 600px) {
    h1 { font-size: 1.4rem; }
    h2 { font-size: 1.2rem; }

    nav ul {
        gap: 0.3rem 0.5rem;
    }

    nav ul li a {
        font-size: 0.8rem;
    }

    main {
        padding: 0 1rem;
        margin: 1.5rem auto;
    }

    figure img {
        width: 150px;
        height: 120px;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="date"],
    input[type="time"],
    select,
    textarea {
        max-width: 100%;
    }
}